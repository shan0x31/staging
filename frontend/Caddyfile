# TLS: Caddy provisions Let's Encrypt automatically for a real DOMAIN;
# for the default "localhost" it uses its internal CA (self-signed).
{$DOMAIN:localhost} {
	encode gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
