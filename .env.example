# Copy to .env and fill in. Never commit .env.

# Postgres password for the compose-internal database.
POSTGRES_PASSWORD=change-me

# Optional: encryption passphrase for unattended scheduled jobs.
# Leave empty to unlock manually in the UI after each restart.
PF_PASSPHRASE=

# Aggregate currency for dashboard totals: INR or USD.
PF_BASE_CURRENCY=INR

# Set a real domain (with DNS pointing at this host) for automatic
# Let's Encrypt TLS; "localhost" uses Caddy's internal self-signed CA.
DOMAIN=localhost
